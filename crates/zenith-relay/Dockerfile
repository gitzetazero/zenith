# The Play with friends relay, for anyone to run (docs/play-with-friends.md, "Running your own relay").
# Build context: the repository root (the workspace's manifests and lockfile):
#   docker build -f crates/zenith-relay/Dockerfile -t zenith-relay .
FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY . .
RUN cargo build --release --locked -p zenith-relay \
    && cp target/release/zenith-relay /zenith-relay

FROM debian:bookworm-slim
COPY --from=build /zenith-relay /usr/local/bin/zenith-relay
ENV PORT=7000
EXPOSE 7000
USER nobody
CMD ["zenith-relay"]
